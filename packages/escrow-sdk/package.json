{
  "name": "@foxlock/escrow-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for the FoxLock milestone escrow contract on Stellar Soroban",
  "author": "VaultFox Protocol <dev@vaultfox.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaultfox-protocol/foxlock-protocol"
  },
  "type": "module",
  "main": "./dist/index.js",
